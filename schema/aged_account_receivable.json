{
    "tableName": "AgedAccountsReceivable",
    "description": "Schema definition for Aged Accounts Receivable that tracks customer payment aging and outstanding balances across different time periods",
    "properties": {
        "customerId": {
            "type": "string",
            "required": true,
            "ref": "Customers.id",
            "json": "$.customerId",
            "desc": "Unique identifier for the customer"
        },
        "company": {
            "type": "string",
            "required": true,
            "ref": "Companies.name",
            "json": "$.company",
            "desc": "The company associated with the receivable"
        },
        "customerNumber": {
            "type": "string",
            "nullable": true,
            "ref": "Customers.number",
            "json": "$.customerNumber",
            "desc": "Customer-specific number"
        },
        "name": {
            "type": "string",
            "nullable": true,
            "ref": "Customers.displayName",
            "json": "$.name",
            "desc": "Display name of the customer"
        },
        "currencyCode": {
            "type": "string",
            "nullable": true,
            "ref": "Currencies.code",
            "json": "$.currencyCode",
            "desc": "Currency code for the receivable"
        },
        "balanceDue": {
            "type": "float64",
            "nullable": true,
            "json": "$.balanceDue",
            "desc": "Total balance due for the receivable"
        },
        "currentAmount": {
            "type": "float64",
            "nullable": true,
            "json": "$.currentAmount",
            "desc": "Amount receivable for the current period"
        },
        "period1Amount": {
            "type": "float64",
            "nullable": true,
            "json": "$.period1Amount",
            "desc": "Amount receivable in period 1"
        },
        "period2Amount": {
            "type": "float64",
            "nullable": true,
            "json": "$.period2Amount",
            "desc": "Amount receivable in period 2"
        },
        "period3Amount": {
            "type": "float64",
            "nullable": true,
            "json": "$.period3Amount",
            "desc": "Amount receivable in period 3"
        },
        "agedAsOfDate": {
            "type": "date",
            "nullable": true,
            "json": "$.agedAsOfDate",
            "desc": "Date as of which the aging calculation is performed"
        },
        "periodLengthFilter": {
            "type": "string",
            "nullable": true,
            "json": "$.periodLengthFilter",
            "desc": "Filter representing the period length used in the aging calculation"
        }
    }
}